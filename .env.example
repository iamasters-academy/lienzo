# Lienzo — configuración del servidor.
# Copia este archivo a .env (o ejecuta: bash scripts/crear-env.sh, que además genera la clave de la base de datos).
# Nunca subas .env a GitHub ni lo compartas.

# Dominio de la pizarra, sin https:// (por ejemplo pizarra.tudominio.com).
# Antes de arrancar, crea en tu proveedor de dominio un registro A que apunte a la IP del servidor.
DOMAIN=

# Clave de la base de datos. scripts/crear-env.sh la genera (a mano: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Opcional: «Texto a diagrama» con Claude. Vacío = IA apagada y sin gasto.
# Con clave, cada uso se cobra en tu cuenta de Anthropic. LIENZO_AI_MODEL cambia el modelo.
ANTHROPIC_API_KEY=
LIENZO_AI_MODEL=

# caddy = Lienzo pone su propio HTTPS. Déjalo vacío solo si otro proxy (por ejemplo, el de DM Engine)
# le da el HTTPS; en ese caso, mira docker-compose.junto-a-dm-engine.yml.
COMPOSE_PROFILES=caddy
